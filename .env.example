# For the demo: a Hugging Face token with Inference Providers permission.
# It is used with the vision-language model and takes precedence over OpenAI.
HF_TOKEN=replace_with_your_hugging_face_token
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct:featherless-ai
# Set to live after adding paid Hugging Face or OpenAI API access. The default
# is the no-cost demo analyser used by the public demo.
FOOD_ANALYSIS_MODE=demo

# Optional OpenAI fallback. Never commit real tokens.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional local/server port.
PORT=4174
