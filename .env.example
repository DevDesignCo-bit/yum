# For the demo: a Hugging Face token with Inference Providers permission.
# It is used with the Food-101 image classifier and takes precedence over OpenAI.
HF_TOKEN=replace_with_your_hugging_face_token
HF_FOOD_MODEL=nateraw/food

# Optional OpenAI fallback. Never commit real tokens.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional local/server port.
PORT=4174
